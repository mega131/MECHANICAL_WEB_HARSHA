# Smart Motor Vibration Monitoring Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Optional PostgreSQL / TimescaleDB Connection
# If omitted or unavailable, the backend seamlessly uses persistent local storage
# DATABASE_URL=postgresql://postgres:password@localhost:5432/motor_vibration_db

# CORS Allowed Origin
CORS_ORIGIN=*

# IoT Hardware Security Token (Optional header verification)
# IOT_DEVICE_TOKEN=motor-sensor-secure-token-2026
